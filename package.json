{
  "name": "xchain-hub",
  "description": "Config oracle and cross-chain coordinator for the XChain Platform. Stores service configs in MariaDB and serves them via JSON-RPC.",
  "version": "0.9.0",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/XChain-Platform/xchain-hub.git"
  },
  "dependencies": {
    "axios": "^1.18.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "express-json-rpc-router": "^1.4.0",
    "express-rate-limit": "^8.5.2",
    "geoip-lite": "^2.0.2",
    "helmet": "^8.2.0",
    "mariadb": "3.5.2",
    "mathjs": "15.2.0",
    "ws": "^8.21.0"
  },
  "scripts": {
    "api": "node ./src/api.js",
    "test": "mocha 'test/unit/**/*.test.js' --timeout 5000 --recursive --exit",
    "coverage": "c8 --reporter=text --reporter=html --include 'src/**/*.js' mocha 'test/unit/**/*.test.js' --timeout 5000 --recursive --exit",
    "coverage:check": "c8 --check-coverage --lines 91.6 --statements 91.6 --branches 80.5 --functions 88.1 --reporter=text-summary --include 'src/**/*.js' mocha 'test/unit/**/*.test.js' --timeout 5000 --recursive --exit",
    "ci": "mocha 'test/unit/**/*.test.js' --timeout 5000 --recursive --exit && npm run ci:security && npm run ci:regression",
    "ci:security": "mocha 'test/security/**/*.test.js' --timeout 5000 --recursive --exit",
    "ci:regression": "mocha 'test/regression/**/*.regression.test.js' --timeout 5000 --recursive --exit",
    "test:integration": "mocha 'test/integration/**/*.test.js' --timeout 30000 --recursive",
    "test:all": "mocha 'test/**/*.test.js' --timeout 30000 --recursive",
    "test:smoke": "mocha 'test/smoke/**/*.smoke.test.js' --timeout 5000 --recursive --bail",
    "test:security": "mocha 'test/security/**/*.test.js' --timeout 5000 --recursive --exit",
    "test:e2e": "mocha 'test/e2e/**/*.e2e.test.js' --timeout 30000 --recursive --exit",
    "test:fuzz": "mocha 'test/fuzz/**/*.fuzz.test.js' --timeout 30000 --recursive",
    "test:perf": "mocha 'test/performance/**/*.perf.test.js' --timeout 300000 --recursive --exit --v8-expose-gc",
    "test:regression": "mocha 'test/regression/**/*.regression.test.js' --timeout 5000 --recursive",
    "test:regression:p0": "mocha 'test/regression/**/*.regression.test.js' --timeout 5000 --recursive --grep '@regression-p0'",
    "test:regression:p0p1": "mocha 'test/regression/**/*.regression.test.js' --timeout 5000 --recursive --grep '@regression-p[01]'",
    "test:chaos": "mocha 'test/chaos/**/*.chaos.test.js' --timeout 30000 --recursive",
    "test:mutate": "stryker run",
    "test:mutate:pilot": "stryker run stryker.config.phase1.json",
    "test:boundary": "mocha 'test/boundary/**/*.boundary.test.js' 'test/unit/boundary/**/*.boundary.test.js' --timeout 5000 --recursive",
    "check:blind-sleeps": "node bin/check-blind-sleeps.js"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/mocha-runner": "^9.6.1",
    "c8": "^11.0.0",
    "chai": "^4.5.0",
    "fast-check": "^4.6.0",
    "mocha": "^11.7.5",
    "nock": "^14.0.0",
    "proxyquire": "^2.1.3",
    "sinon": "^21.0.3"
  },
  "overrides": {
    "brace-expansion": "^5.0.8",
    "minimatch": "^10.2.5",
    "qs": "^6.15.2",
    "serialize-javascript": "^7.0.5",
    "diff": "^8.0.3",
    "tmp": "^0.2.7",
    "fast-uri": "^3.1.5",
    "ip-address": "^10.3.1",
    "ajv": "^8.17.2",
    "decimal.js": "10.4.3",
    "js-yaml": "^4.3.0",
    "form-data": "^4.0.6"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
