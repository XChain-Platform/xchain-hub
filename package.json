{
  "name": "xchain-hub",
  "description": "Config oracle and cross-chain coordinator for the XChain Platform. Stores service configs in MariaDB and serves them via JSON-RPC.",
  "version": "2.2.11",
  "license": "SEE LICENSE IN LICENSE.md",
  "repository": {
    "type": "git",
    "url": "https://github.com/XChain-platform/xchain-hub.git"
  },
  "dependencies": {
    "axios": "^1.16.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "express-json-rpc-router": "^1.4.0",
    "express-rate-limit": "^7.5.0",
    "geoip-lite": "^2.0.2",
    "helmet": "^7.1.0",
    "mariadb": "3.2.3",
    "ws": "^8.18.0"
  },
  "scripts": {
    "api": "node ./src/api.js",
    "test": "mocha 'test/unit/**/*.test.js' --timeout 5000 --recursive",
    "test:integration": "mocha 'test/integration/**/*.test.js' --timeout 30000 --recursive",
    "test:all": "mocha 'test/**/*.test.js' --timeout 30000 --recursive",
    "test:smoke": "mocha 'test/smoke/**/*.smoke.test.js' --timeout 5000 --recursive --bail",
    "test:e2e": "mocha 'test/e2e/**/*.e2e.test.js' --timeout 30000 --recursive",
    "test:fuzz": "mocha 'test/fuzz/**/*.fuzz.test.js' --timeout 30000 --recursive",
    "test:perf": "mocha 'test/performance/**/*.perf.test.js' --timeout 300000 --recursive",
    "test:regression": "mocha 'test/regression/**/*.regression.test.js' --timeout 5000 --recursive",
    "test:regression:p0": "mocha 'test/regression/**/*.regression.test.js' --timeout 5000 --recursive --grep '@regression-p0'",
    "test:regression:p0p1": "mocha 'test/regression/**/*.regression.test.js' --timeout 5000 --recursive --grep '@regression-p[01]'",
    "test:chaos": "mocha 'test/chaos/**/*.chaos.test.js' --timeout 30000 --recursive",
    "test:mutate": "stryker run",
    "test:mutate:pilot": "stryker run stryker.config.phase1.json"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^8.7.1",
    "@stryker-mutator/mocha-runner": "^8.7.1",
    "chai": "^4.5.0",
    "fast-check": "^3.23.2",
    "mocha": "^11.7.5",
    "nock": "^14.0.0",
    "proxyquire": "^2.1.3",
    "sinon": "^21.0.3"
  },
  "overrides": {
    "qs": "^6.15.2",
    "serialize-javascript": "^7.0.5",
    "diff": "^8.0.3",
    "tmp": "^0.2.7",
    "fast-uri": "^3.1.2"
  }
}
