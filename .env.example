# xchain-hub configuration. Copy to .env and fill in values.
# Config oracle and cross-chain action coordinator. See CONFIGURATION.md for a
# full description of every variable, including the two that degrade security
# when left empty (HUB_API_KEY and SIGNING_PRIVKEY_SECRET).

# --- Core API -----------------------------------------------------------------
# Required: API port the hub listens on (no default, so the hub will not bind
# without it).
HUB_PORT=10000
# Optional: bind interface (default 0.0.0.0).
# HUB_HOST=0.0.0.0
# Optional: DB keep-alive ping interval in ms (default 30000).
# HUB_DB_KEEPALIVE_INTERVAL=30000

# --- Security -----------------------------------------------------------------
# Strongly recommended: API key protecting write methods and WebSocket
# upgrades. When set, those paths reject requests (401) unless the caller
# presents this key. When left empty they are OPEN, and a warning is logged at
# startup. ALWAYS set a strong random value in production. See
# CONFIGURATION.md "Silent-failure variables".
HUB_API_KEY=your-strong-api-key-here
# Optional: requests per minute per client (default 100).
# HUB_RATE_LIMIT_RPM=100
# Optional: allowed CORS origin(s) (default disabled). `*` allows any origin;
# otherwise give one origin, or a comma-separated allowlist matched per-origin.
# A list is what browser wallet shells need, because each sends a different
# origin: iOS 'capacitor://localhost', Android 'https://localhost', the hosted
# web wallet its own https origin.
# CORS_ORIGIN=
# CORS_ORIGIN=capacitor://localhost,https://localhost,https://wallet.xchain.io

# --- Database (MariaDB) -------------------------------------------------------
HUB_DB_HOST=127.0.0.1
HUB_DB_PORT=3306
HUB_DB_NAME=xchain_hub
HUB_DB_USER=xchain
# Name it HUB_DB_SECRET, not the deprecated HUB_DB_PASS: automatic secret
# redaction keys on the variable name, and only the _SECRET form is matched,
# so a HUB_DB_PASS line prints in full wherever this file gets read.
HUB_DB_SECRET=your-db-password-here
# Optional: per-query timeout in ms (default 30000).
# DB_QUERY_TIMEOUT=30000
# Optional: connection-pool connect/acquire timeouts in ms (default 10000 each).
# DB_CONNECT_TIMEOUT=10000
# DB_ACQUIRE_TIMEOUT=10000

# --- Telemetry collector (anonymous node pings) -------------------------------
# Optional: accept telemetry pings (default true). Set false on a local hub.
# TELEMETRY_ENABLED=true
# Optional: prune telemetry rows older than N days (default 90).
# TELEMETRY_RETENTION_DAYS=90
# Optional: secret salt for the one-way IP hash. Without it, ip_hash is left
# null (the raw IP is never stored either way).
# TELEMETRY_IP_SALT=

# --- P2P validator cluster ----------------------------------------------------
# P2P is ENABLED only when P2P_VALIDATOR_ADDR is set. Leave it empty to run a
# standalone (non-federated) hub.
# P2P_VALIDATOR_ADDR=
# Required WHEN P2P is enabled: Unix-ms timestamp anchoring oracle round
# numbering. ALL hubs in the federation must share the exact same value. The
# hub refuses to start if P2P is enabled and this is unset.
# ORACLE_EPOCH_START=

# !! IMPORTANT !! Ed25519 signing key (64 hex chars / 32-byte seed) that
# authenticates this hub's P2P messages. When empty, messages go out UNSIGNED
# and this hub has NO identity in the federation, silently. Generate one and
# keep it secret. See CONFIGURATION.md "Silent-failure variables".
# SIGNING_PRIVKEY_SECRET=your-64-hex-char-ed25519-seed-here
# Optional: reject unsigned/invalid peer messages (default true).
# REQUIRE_SIGNATURES=true

# Optional: P2P listener + seed peers.
# P2P_PORT=10001
# P2P_HOST=0.0.0.0
# SEED_NODES=                        # comma-separated host:port list
# P2P_HEARTBEAT_INTERVAL=15000
# P2P_DEDUP_PRUNE_INTERVAL=30000
# P2P_WS_PING_INTERVAL=30000
# P2P_SIGNER_SET_REFRESH_MS=30000     # transport signer-set refresh poll (Option A auth)
# P2P_RECONNECT_BASE=2000
# P2P_RECONNECT_MAX=60000
# P2P_MSG_DEDUP_TTL=60000
# P2P_MAX_PAYLOAD=1048576            # bytes

# --- Oracle price rounds (P2P) ------------------------------------------------
# ORACLE_ROUND_INTERVAL=600000       # ms (10 min)
# ORACLE_SUBMISSION_WINDOW=180000    # ms (3 min)
# ORACLE_REWARD_PER_ROUND=10.00000000
# ORACLE_FINALIZATION_TIMEOUT=120000 # ms
# ORACLE_MIN_SUBMISSIONS=1
# Retention window for the diagnostic oracle_submissions audit table, in rounds.
# Default 12960 (~90 days at the 10-minute round default). 0 disables pruning.
# ORACLE_SUBMISSIONS_RETENTION_ROUNDS=12960
# SLASH_DEVIATION_THRESHOLD=0.05
# SLASH_MISSED_ROUNDS_THRESHOLD=30

# --- Price feed API keys ------------------------------------------------------
# COINGECKO_API_KEY=
# COINMARKETCAP_API_KEY=
# PRICE_FETCH_TIMEOUT=10000          # ms

# --- PBFT consensus -----------------------------------------------------------
# PBFT_TIMEOUT=30000                 # ms
# MIN_VALIDATORS=1

# --- Capabilities -------------------------------------------------------------
# Optional: path to the capability/self-test JSON config (MIN_STAKE thresholds,
# per-capability self-test blocks).
# HUB_CAPABILITY_CONFIG=

# --- Cross-chain call relay (XCALL) -------------------------------------------
# Forward margin, in blocks of the gating chain, applied to a relayed row's
# effective_time so it is written + propagated everywhere BEFORE any chain reaches
# the block it applies at. Without it (margin 0) effective_time = the finalization
# instant, and a node whose tip already sits at that second can reach the eligible
# block before the row arrives, injecting the execution/callback a block late and
# permanently shifting its action-index counter relative to a replaying node
# (forking the ledger). Suggested 3–5; capped internally below the follower clock-
# skew bound. Default 4.
# XCALL_RELAY_MARGIN_BLOCKS=4

# --- BTC attestation publisher ------------------------------------------------
# Wallet the hub uses to publish ATTEST responses on Bitcoin.
# BTC_ADDRESS=your-btc-address-here
# BTC_PUBKEY_HEX=your-btc-pubkey-hex-here
# BTC_ENCODER_URL=
# BTC_ENCODER_API_KEY=
# ATTESTATION_QUEUE_PATH=./data/attestation-queue.jsonl
# ATTESTATION_TIMEOUT=60000          # ms
# Failover / crash-replay for finalized ATTEST responses (publisher write-ahead log):
# ATTESTATION_FAILOVER_POLL_MS=30000        # sweep cadence for replay + follower step-in
# ATTESTATION_FAILOVER_WINDOW_BLOCKS=2      # leader silence (blocks) before a follower steps in
# ATTESTATION_LEADER_RETRY_MS=60000         # grace before the sweep retries the leader's own entry
# ATTESTATION_BLOCK_MS=600000               # approx block time used to translate the window to wall-clock
# REORG_TIMEOUT=60000                # ms

# --- Attestation relay (origin-chain ATTEST) ----------------------------------
# Attestation staking lives on BTC, so an ATTEST made on LTC/DOGE is relayed to
# BTC as a v3 request and the answer relayed back to the origin chain as a v4
# response. Off unless ATTEST_RELAY_ENABLED=1.
# ATTEST_RELAY_ENABLED=0
# ATTEST_RELAY_POLL_MS=15000
# ATTEST_RELAY_QUEUE_PATH=./data/attest-relay-queue.jsonl
# ATTEST_RELAY_FAILOVER_MS=1200000   # ms of leader silence per rank before step-in
#
# Per-origin-chain broadcast rail, one set per chain the relay answers on. These
# are read dynamically as <COIN>_*, so no static scan of the source will list
# them. WITHOUT them a v4 is finalized and then HELD FOREVER, behind a single
# startup warning; watch attest_relay.awaiting_broadcast on /health.
# LTC_ADDRESS=your-ltc-address-here
# LTC_PUBKEY_HEX=your-ltc-pubkey-hex-here
# LTC_ENCODER_URL=
# LTC_ENCODER_API_KEY=
# LTC_INDEXER_API_URL=
# LTC_INDEXER_API_KEY=
# DOGE_ADDRESS / DOGE_PUBKEY_HEX / DOGE_ENCODER_URL / DOGE_ENCODER_API_KEY are
# shared with the oracle publisher below; DOGE_INDEXER_API_URL + _API_KEY are the
# relay's read side for DOGE-origin requests.
# DOGE_INDEXER_API_URL=
# DOGE_INDEXER_API_KEY=

# --- DOGE oracle publisher ----------------------------------------------------
# Wallet the hub uses to publish oracle prices on Dogecoin.
# DOGE_ADDRESS=your-doge-address-here
# DOGE_PUBKEY_HEX=your-doge-pubkey-hex-here
# DOGE_ENCODER_URL=
# DOGE_ENCODER_API_KEY=
# DOGE_LOW_BALANCE_THRESHOLD=10      # DOGE
# PUBLISHER_QUEUE_PATH=./data/publisher-queue.jsonl
# PUBLISHER_MAX_ATTEMPTS=5

# --- Reward tracker (reads BTC indexer) ---------------------------------------
# BTC_INDEXER_API_URL=
# BTC_INDEXER_API_KEY=
# Max blocks the indexer's committed tip may trail the decoder before the hub
# treats its latest-block response as stale and falls back to graceful
# degradation (avoids anchoring consensus snapshots on a lagging indexer).
# MAX_INDEXER_LAG_BLOCKS=200

# --- Governance ---------------------------------------------------------------
# GOV_VOTING_PERIOD=604800000        # ms (7 days)
# GOVERNANCE_TALLY_INTERVAL=60000    # ms

# --- LLM attestation provider -------------------------------------------------
# Optional: default judge model (must be in the approved-models list;
# default claude-sonnet-4-6).
# LLM_DEFAULT_MODEL=claude-sonnet-4-6
# Optional: path to the Claude CLI binary (default "claude").
# CLAUDE_BIN=claude
