# The database the DB-backed tiers (perf, and any suite through
# test/helpers/testDb.js) name for themselves.
#
# It is NOT the .env-rendered ci_* schema the gate makes from .env.example:
# testDb.js creates its own xchain_hub_test and then builds tables in it, and
# the venue ci user holds ALL only on ci_% (plus a host-local xchain_hub_test%
# grant that exists on one venue and on no other), so the tier passed or
# failed depending on which venue the dispatcher picked.
#
# The `name=ENV_VAR` form is the isolated one: the gate creates
# ci_<name>_<run-id> and exports the variable, so a gate run and a hand run on
# the same venue can never collide.
xchain_hub_test=TEST_DB_NAME
