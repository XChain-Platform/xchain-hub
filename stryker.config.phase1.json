{
  "$schema": "https://raw.githubusercontent.com/stryker-mutator/stryker/master/packages/core/schema/stryker-core.json",
  "mutate": [
    "src/Consensus.js",
    "src/OracleConsensus.js"
  ],
  "testRunner": "mocha",
  "mochaOptions": {
    "spec": ["test/unit/**/*.test.js"]
  },
  "reporters": ["html", "json", "progress"],
  "htmlReporter": {
    "fileName": "reports/mutation/phase1/index.html"
  },
  "jsonReporter": {
    "fileName": "reports/mutation/phase1/report.json"
  },
  "concurrency": 4,
  "timeoutMS": 10000,
  "thresholds": {
    "high": 95,
    "low": 85,
    "break": 80
  },
  "tempDirName": ".stryker-tmp",
  "cleanTempDir": true
}
